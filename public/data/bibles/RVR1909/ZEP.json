g":"2729"}]},{"bookId":"ZEP","chapter":3,"verse":14,"version":"RVR1909","originalLanguage":"hebrew","text":"Canta, oh hija de Sion; da voces de júbilo, oh Israel; gózate y regocíjate de todo corazón, hija de Jerusalén.","strongTokens":[{"word":"Canta","strong":"7442"},{"word":"hija","strong":"1323"},{"word":"Sion","strong":"6726"},{"word":"Sion","strong":"7321"},{"word":"gózate","strong":"3478"},{"word":"y","strong":"8055"},{"word":"de","strong":"5937"},{"word":"corazón","strong":"3605"},{"word":"hija","strong":"3820"},{"word":"de","strong":"1323"},{"word":"de","strong":"3389"}]},{"bookId":"ZEP","chapter":3,"verse":15,"version":"RVR1909","originalLanguage":"hebrew","text":"Jehová ha apartado tus juicios, ha echado fuera tus enemigos; Jehová es Rey de Israel en medio de ti; nunca más verás el mal.","strongTokens":[{"word":"Jehová","strong":"5493"},{"word":"Jehová","strong":"3068"},{"word":"apartado","strong":"5620"},{"word":"juicios","strong":"4941"},{"word":"echado","strong":"6437"},{"word":"enemigos","strong":"341"},{"word":"Jehová","strong":"3068"},{"word":"Rey","strong":"4428"},{"word":"Israel","strong":"3478"},{"word":"medio","strong":"7130"},{"word":"nunca","strong":"3808"},{"word":"más","strong":"5750"},{"word":"verás","strong":"3372"},{"word":"mal","strong":"7451"}]},{"bookId":"ZEP","chapter":3,"verse":16,"version":"RVR1909","originalLanguage":"hebrew","text":"En aquel tiempo se dirá a Jerusalén: No temas; Sion, no se debiliten tus manos.","strongTokens":[{"word":"dirá","strong":"3117"},{"word":"dirá","strong":"559"},{"word":"dirá","strong":"1931"},{"word":"Jerusalén","strong":"3389"},{"word":"No","strong":"408"},{"word":"temas","strong":"3372"},{"word":"Sion","strong":"6726"},{"word":"no","strong":"408"},{"word":"debiliten","strong":"7503"},{"word":"manos","strong":"3027"}]},{"bookId":"ZEP","chapter":3,"verse":17,"version":"RVR1909","originalLanguage":"hebrew","text":"Jehová está en medio de ti, poderoso, él salvará; se gozará sobre ti con alegría, callará de amor, se regocijará sobre ti con cánticos.","strongTokens":[{"word":"Jehová","strong":"3068"},{"word":"Jehová","strong":"430"},{"word":"medio","strong":"7130"},{"word":"poderoso","strong":"1368"},{"word":"salvará","strong":"3467"},{"word":"salvará","strong":"7797"},{"word":"sobre","strong":"5921"},{"word":"alegría","strong":"8057"},{"word":"callará","strong":"2790"},{"word":"callará","strong":"160"},{"word":"callará","strong":"1523"},{"word":"sobre","strong":"5921"},{"word":"sobre","strong":"7440"}]},{"bookId":"ZEP","chapter":3,"verse":18,"version":"RVR1909","originalLanguage":"hebrew","text":"Reuniré a los fastidiados por causa del largo tiempo; tuyos, fueron, para quienes el oprobio de ella era una carga.","strongTokens":[{"word":"Reuniré","strong":"622"},{"word":"fastidiados","strong":"3013"},{"word":"del","strong":"4480"},{"word":"tiempo","strong":"4150"},{"word":"tuyos","strong":"4480"},{"word":"fueron","strong":"1961"},{"word":"fueron","strong":"4864"},{"word":"de","strong":"2781"},{"word":"ella","strong":"5921"}]},{"bookId":"ZEP","chapter":3,"verse":19,"version":"RVR1909","originalLanguage":"hebrew","text":"He aquí, en aquel tiempo yo apremiaré a todos tus opresores; y salvaré a la que cojea, y recogeré la descarriada; y os pondré por alabanza y por renombre en toda la tierra.","strongTokens":[{"word":"a","strong":"2005"},{"word":"a","strong":"6213"},{"word":"tus","strong":"3605"},{"word":"opresores","strong":"853"},{"word":"y","strong":"6031"},{"word":"y","strong":"6256"},{"word":"y","strong":"1931"},{"word":"a","strong":"3467"},{"word":"y","strong":"6760"},{"word":"la","strong":"6908"},{"word":"la","strong":"7760"},{"word":"y","strong":"5080"},{"word":"y","strong":"8416"},{"word":"en","strong":"8034"},{"word":"la","strong":"3605"},{"word":"tierra","strong":"776"},{"word":"tierra","strong":"1322"}]},{"bookId":"ZEP","chapter":3,"verse":20,"version":"RVR1909","originalLanguage":"hebrew","text":"En aquel tiempo yo os traeré, en aquel tiempo os reuniré yo; pues os pondré para renombre y para alabanza entre todos los pueblos de la tierra, cuando levante vuestro cautiverio delante de vuestros ojos, dice Jehová.","strongTokens":[{"word":"tiempo","strong":"6256"},{"word":"tiempo","strong":"1931"},{"word":"tiempo","strong":"935"},{"word":"reuniré","strong":"6908"},{"word":"pues","strong":"3588"},{"word":"pondré","strong":"5414"},{"word":"renombre","strong":"8034"},{"word":"alabanza","strong":"8416"},{"word":"todos","strong":"3605"},{"word":"pueblos","strong":"5971"},{"word":"tierra","strong":"776"},{"word":"tierra","strong":"7725"},{"word":"cautiverio","strong":"7622"},{"word":"ojos","strong":"5869"},{"word":"dice","strong":"559"},{"word":"Jehová","strong":"3068"}]}]}}