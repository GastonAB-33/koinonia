ro Dios, que habito en Sion, mi santo monte; y Jerusalén será santa, y extraños no pasarán más por ella.","strongTokens":[{"word":"conoceréis","strong":"3045"},{"word":"que","strong":"3588"},{"word":"yo","strong":"589"},{"word":"Jehová","strong":"3068"},{"word":"Jehová","strong":"430"},{"word":"habito","strong":"7931"},{"word":"Sion","strong":"6726"},{"word":"mi","strong":"589"},{"word":"santo","strong":"6944"},{"word":"santo","strong":"2114"},{"word":"monte","strong":"2022"},{"word":"Jerusalén","strong":"3389"},{"word":"será","strong":"1961"},{"word":"santa","strong":"6944"},{"word":"extraños","strong":"2213"},{"word":"no","strong":"3808"},{"word":"pasarán","strong":"5674"},{"word":"más","strong":"5750"}]},{"bookId":"JOL","chapter":3,"verse":18,"version":"RVR1909","originalLanguage":"hebrew","text":"Sucederá en aquel tiempo, que los montes destilarán mosto, y los collados fluirán leche, y por todos los arroyos de Judá correrán aguas; y saldrá una fuente de la casa de Jehová, y regará el valle de Sitim.","strongTokens":[{"word":"Sucederá","strong":"1961"},{"word":"Sucederá","strong":"3117"},{"word":"Sucederá","strong":"1931"},{"word":"montes","strong":"2022"},{"word":"destilarán","strong":"5197"},{"word":"mosto","strong":"6071"},{"word":"collados","strong":"1389"},{"word":"fluirán","strong":"1980"},{"word":"leche","strong":"2461"},{"word":"todos","strong":"3605"},{"word":"arroyos","strong":"650"},{"word":"Judá","strong":"3063"},{"word":"correrán","strong":"1980"},{"word":"aguas","strong":"4325"},{"word":"saldrá","strong":"3318"},{"word":"fuente","strong":"4599"},{"word":"casa","strong":"1004"},{"word":"Jehová","strong":"3068"},{"word":"regará","strong":"8248"},{"word":"valle","strong":"5158"},{"word":"Sitim","strong":"7851"}]},{"bookId":"JOL","chapter":3,"verse":19,"version":"RVR1909","originalLanguage":"hebrew","text":"Egipto será destruido, y Edom será vuelto en desierto asolado, por la injuria hecha a los hijos de Judá; porque derramaron en su tierra sangre inocente.","strongTokens":[{"word":"Egipto","strong":"4714"},{"word":"será","strong":"1961"},{"word":"destruido","strong":"8077"},{"word":"Edom","strong":"123"},{"word":"será","strong":"1961"},{"word":"desierto","strong":"4057"},{"word":"asolado","strong":"8077"},{"word":"injuria","strong":"2555"},{"word":"de","strong":"1121"},{"word":"porque","strong":"3063"},{"word":"derramaron","strong":"834"},{"word":"en","strong":"8210"},{"word":"sangre","strong":"776"},{"word":"inocente","strong":"1818"},{"word":"inocente","strong":"5355"}]},{"bookId":"JOL","chapter":3,"verse":20,"version":"RVR1909","originalLanguage":"hebrew","text":"Pero Judá será habitada para siempre, y Jerusalén por generación y generación.","strongTokens":[{"word":"Judá","strong":"3063"},{"word":"habitada","strong":"3427"},{"word":"siempre","strong":"5769"},{"word":"Jerusalén","strong":"3389"},{"word":"generación","strong":"1755"},{"word":"generación","strong":"1755"}]},{"bookId":"JOL","chapter":3,"verse":21,"version":"RVR1909","originalLanguage":"hebrew","text":"Y limpiaré la sangre de los que no había limpiado; y Jehová morará en Sion.","strongTokens":[{"word":"limpiaré","strong":"5352"},{"word":"sangre","strong":"1818"},{"word":"no","strong":"3808"},{"word":"limpiado","strong":"5352"},{"word":"Jehová","strong":"3068"},{"word":"morará","strong":"7931"},{"word":"Sion","strong":"6726"}]}]}}