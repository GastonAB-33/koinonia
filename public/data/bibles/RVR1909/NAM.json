":"aguas","strong":"4325"},{"word":"ellos","strong":"1992"},{"word":"ellos","strong":"5127"},{"word":"huyen","strong":"5251"},{"word":"Deteneos","strong":"5975"},{"word":"deteneos","strong":"5975"},{"word":"ninguno","strong":"369"},{"word":"mira","strong":"6437"}]},{"bookId":"NAM","chapter":2,"verse":9,"version":"RVR1909","originalLanguage":"hebrew","text":"Saquead plata, saquead oro; no hay fin de las riquezas y suntuosidad de toda clase de efectos codiciables.","strongTokens":[{"word":"Saquead","strong":"962"},{"word":"plata","strong":"3701"},{"word":"saquead","strong":"962"},{"word":"oro","strong":"2091"},{"word":"no","strong":"369"},{"word":"fin","strong":"7097"},{"word":"riquezas","strong":"8498"},{"word":"suntuosidad","strong":"3519"},{"word":"toda","strong":"3605"},{"word":"efectos","strong":"3627"},{"word":"codiciables","strong":"2532"}]},{"bookId":"NAM","chapter":2,"verse":10,"version":"RVR1909","originalLanguage":"hebrew","text":"Vacía, agotada y desolada está, y el corazón desfallecido; temblor de rodillas, dolor en las entrañas, rostros demudados.","strongTokens":[{"word":"Vacía","strong":"950"},{"word":"agotada","strong":"4003"},{"word":"desolada","strong":"1110"},{"word":"corazón","strong":"3820"},{"word":"corazón","strong":"4549"},{"word":"corazón","strong":"6375"},{"word":"rodillas","strong":"1290"},{"word":"dolor","strong":"2479"},{"word":"las","strong":"3605"},{"word":"entrañas","strong":"4975"},{"word":"entrañas","strong":"6440"},{"word":"rostros","strong":"3605"},{"word":"rostros","strong":"6908"},{"word":"rostros","strong":"6289"}]},{"bookId":"NAM","chapter":2,"verse":11,"version":"RVR1909","originalLanguage":"hebrew","text":"¿Qué es de la guarida de los leones, y de la majada de los cachorros de los leones, donde se recogía el león y la leona, y los cachorros del león, y no había quien los espantase?","strongTokens":[{"word":"Qué","strong":"346"},{"word":"de","strong":"4583"},{"word":"y","strong":"738"},{"word":"majada","strong":"4829"},{"word":"de","strong":"1931"},{"word":"se","strong":"3715"},{"word":"recogía","strong":"834"},{"word":"león","strong":"1980"},{"word":"la","strong":"738"},{"word":"y","strong":"3833"},{"word":"cachorros","strong":"8033"},{"word":"león","strong":"1482"},{"word":"no","strong":"738"},{"word":"quien","strong":"369"},{"word":"quien","strong":"2729"}]},{"bookId":"NAM","chapter":2,"verse":12,"version":"RVR1909","originalLanguage":"hebrew","text":"El león arrebataba en abundancia para sus cachorros, y ahogaba para sus leonas, y llenaba de presa sus cavernas, y de robo sus guaridas.","strongTokens":[{"word":"arrebataba","strong":"738"},{"word":"en","strong":"2964"},{"word":"para","strong":"1767"},{"word":"y","strong":"1484"},{"word":"para","strong":"2614"},{"word":"y","strong":"3833"},{"word":"de","strong":"4390"},{"word":"sus","strong":"2963"},{"word":"y","strong":"2356"},{"word":"y","strong":"4585"},{"word":"sus","strong":"2966"}]},{"bookId":"NAM","chapter":2,"verse":13,"version":"RVR1909","originalLanguage":"hebrew","text":"Heme aquí contra ti, dice Jehová de los ejércitos. Encenderé y reduciré a humo tus carros, y espada devorará tus leoncillos; y cortaré de la tierra tu robo, y nunca más se oirá la voz de tus mensajeros.","strongTokens":[{"word":"contra","strong":"2005"},{"word":"contra","strong":"413"},{"word":"dice","strong":"5002"},{"word":"Jehová","strong":"3068"},{"word":"ejércitos","strong":"6635"},{"word":"Encenderé","strong":"1197"},{"word":"humo","strong":"6227"},{"word":"carros","strong":"7393"},{"word":"espada","strong":"2719"},{"word":"devorará","strong":"398"},{"word":"leoncillos","strong":"3715"},{"word":"cortaré","strong":"3772"},{"word":"tierra","strong":"776"},{"word":"robo","strong":"2964"},{"word":"nunca","strong":"3808"},{"word":"más","strong":"5750"},{"word":"oirá","strong":"8085"},{"word":"voz","strong":"6963"},{"word":"mensajeros","strong":"4397"}]}],"3":[{"bookId":"NAM","chapter":3,"verse":1,"version":"RVR1909","originalLanguage":"hebrew","text":"¡Ay de