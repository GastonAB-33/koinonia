rse":4,"version":"RVR1909","originalLanguage":"hebrew","text":"Y comenzó Jonás a entrar por la ciudad, camino de un día, y predicaba diciendo: De aquí a cuarenta días Nínive será destruida.","strongTokens":[{"word":"comenzó","strong":"2490"},{"word":"Jonás","strong":"3124"},{"word":"Jonás","strong":"935"},{"word":"ciudad","strong":"5892"},{"word":"camino","strong":"4109"},{"word":"un","strong":"259"},{"word":"día","strong":"3117"},{"word":"predicaba","strong":"7121"},{"word":"diciendo","strong":"559"},{"word":"aquí","strong":"5750"},{"word":"aquí","strong":"705"},{"word":"días","strong":"3117"},{"word":"Nínive","strong":"5210"},{"word":"destruida","strong":"2015"}]},{"bookId":"JON","chapter":3,"verse":5,"version":"RVR1909","originalLanguage":"hebrew","text":"Y los hombres de Nínive creyeron a Dios, y proclamaron ayuno, y se vistieron de cilicio desde el mayor hasta el menor de ellos.","strongTokens":[{"word":"Nínive","strong":"5210"},{"word":"creyeron","strong":"539"},{"word":"creyeron","strong":"376"},{"word":"Dios","strong":"430"},{"word":"proclamaron","strong":"7121"},{"word":"ayuno","strong":"6685"},{"word":"vistieron","strong":"3847"},{"word":"cilicio","strong":"8242"},{"word":"mayor","strong":"1419"},{"word":"hasta","strong":"5704"},{"word":"menor","strong":"6996"}]},{"bookId":"JON","chapter":3,"verse":6,"version":"RVR1909","originalLanguage":"hebrew","text":"Y llegó la noticia hasta el rey de Nínive, y se levantó de su silla, se despojó de su vestido, y se cubrió de cilicio y se sentó sobre ceniza.","strongTokens":[{"word":"llegó","strong":"5060"},{"word":"noticia","strong":"1697"},{"word":"hasta","strong":"413"},{"word":"rey","strong":"4428"},{"word":"Nínive","strong":"5210"},{"word":"Nínive","strong":"6965"},{"word":"silla","strong":"3680"},{"word":"despojó","strong":"5674"},{"word":"vestido","strong":"155"},{"word":"vestido","strong":"5921"},{"word":"cubrió","strong":"3678"},{"word":"cilicio","strong":"8242"},{"word":"sentó","strong":"3427"},{"word":"sobre