# Google Gemini API Key
# Puedes obtener una clave gratuita en: https://aistudio.google.com/app/apikey
# Para utilizarla, crea un archivo llamado ".env.local" y pega tu clave allí:
VITE_GEMINI_API_KEY=AIzaSy...

# Google OAuth 2.0 Client ID (Inicio de Sesión con Google)
# Puedes obtenerlo en Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
